<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLoginFlow.Views.LoginPage"
                         
             xmlns:viewModels="clr-namespace:MauiLoginFlow.ViewModels"
             
             
             Title="LoginPage">


    <ContentPage.BindingContext>
        <viewModels:LoginPageViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
        <Label 
            Text="Login or logout"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <StackLayout Orientation="Horizontal" Spacing="20">
            <Button Command="{Binding LoginCommand}"  Text="Login!"></Button>
            <Button Command="{Binding LogoutCommand}" Text="Logout!"></Button>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>